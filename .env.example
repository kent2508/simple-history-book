# Supabase — lấy tại Dashboard → Project Settings → API
# Copy file này thành .env rồi điền giá trị thật.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Chỉ dùng ở local cho script seed dữ liệu (npm run seed:events).
# KHÔNG commit giá trị thật, KHÔNG dùng trong code frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tài khoản admin cho script npm run create:admin (chỉ dùng ở local).
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password
